# ========================================
# reCAPTCHA v3 Configuration
# ========================================
# Site Key (público - pode estar no repositório)
VITE_RECAPTCHA_SITE_KEY=SEU_SITE_KEY
# Secret Key (PRIVADO - NUNCA commit no git)
# Obtenha em: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=SUA_SECRET_KEY

# ========================================
# Email SMTP Configuration (Gmail)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Usuário e Senha de Aplicativo Gmail
# IMPORTANTE: Usar "App Password" do Gmail, não a senha normal
# Gerar em: https://myaccount.google.com/apppasswords
SMTP_USER=EMAIL_DO_APLICATIVO_GMAIL
SMTP_PASS=SENHA_DO_APLICATIVO_GMAIL
MAIL_TO=EMAIL_DESTINO_CONTATO

# ========================================
# Servidor Backend
# ========================================
PORT=3000
NODE_ENV=development